{
  "target_url": "https://uppsc.up.nic.in/Default.aspx",
  "list_container": "marquee span.content-sect, div.Press_Segment li",
  "request_chain": [
    {
      "method": "GET",
      "url": "https://uppsc.up.nic.in/Default.aspx",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:108.0) Gecko/20100101 Firefox/108.0"
      }
    }
  ],
  "static_values": {
    "sender": "UPPSC Update"
  },
  "fields": {
    "title": "a",
    "raw_text": "_self_"
  },
  "metadata_extractors": {
    "external_url": "a::attr(href)"
  },
  "transformers": {
    "regex_extract": {
      "last_date": {
        "source": "raw_text",
        "pattern": "(\\d{2}[-/]\\d{2}[-/]\\d{4}|\\d{1,2}\\s+[A-Za-z]+\\s+\\d{4})"
      }
    },
    "resolve_url": [
      "external_url"
    ],
    "remove_fields": [
      "raw_text"
    ]
  }
}
