{
  "target_url": "/public-notices/",
"list_container": "div.wpb_wrapper ul li",
  "fields": {
    "title": "_self_"
  },
  "metadata_extractors": {
    "external_url": "a::attr(href)"
  },
  "transformers": {
    "regex_extract": {
      "publish_date": {
        "source": "external_url",
        "pattern": "/uploads/\\d{4}/\\d{2}/(\\d{8})"
      }
    },
    "resolve_url": [
      "external_url"
    ]
  }
}
