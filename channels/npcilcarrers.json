{
  "target_url": "https://npcilcareers.co.in/MainSiten/DefaultInfo.aspx",
  "dataType": "SEQUENTIAL_LIST",
  "list_container": "div.card-header, table:first-of-type tr:nth-child(n+2)",
  "state_trigger": {
    "selector": "div.card-header",
    "field_name": "sender"
  },
  "fields": {
    "title": "td:nth-child(2)",
    "publish_date": "td:nth-child(3)",
    "last_date": "td:nth-child(4)",
    "current_status": "td:nth-child(5)"
  },
  "metadata_extractors": {
    "doc_url": "td:nth-child(2) a::attr(href)",
    "external_url": "td:nth-child(6) a::attr(href)"
  },
  "transformers": {
    "resolve_url": [
      "doc_url",
      "external_url"
    ]
  }
}
