{
  "target_url": "https://www.freejobalert.com/latest-notifications/",
  "dataType": "SEQUENTIAL_LIST",
  "list_container": "h4.latsec, tr.lattrbord",
  "state_trigger": {
    "selector": "h4.latsec",
    "field_name": "sender"
  },
  "fields": {
    "publish_date": "td:nth-child(1)",
    "board_temp": "td:nth-child(2)",
    "post_temp": "td:nth-child(3)",
    "qualification": "td:nth-child(4)",
    "advt_no": "td:nth-child(5)",
    "last_date": "td:nth-child(6)"
  },
  "metadata_extractors": {
    "external_url": "td:last-child a::attr(href)"
  },
  "transformers": {
    "replace_text": {
      "fields": ["advt_no"],
      "target": "–",
      "replacement": ""
    },
    "template": {
      "title": "{board_temp}</br>{post_temp}"
    },
    "resolve_url": ["external_url"]
  }
}
